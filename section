create database airport;
go

use airport;
go

create table flights (
    flightid int primary key identity(1,1),
    flightnumber varchar(10) not null,
    departurecity varchar(50) not null,
    arrivalcity varchar(50) not null,
    departuredatetime datetime not null,
    arrivaldatetime datetime not null,
    duration time not null,
    totalseats int not null,
    businessseats int not null,
    economyseats int not null
);
go

create table passengers (
    passengerid int primary key identity(1,1),
    firstname varchar(50) not null,
    lastname varchar(50) not null,
    passportnumber varchar(20) not null
);
go

create table tickets (
    ticketid int primary key identity(1,1),
    flightid int,
    passengerid int,
    class varchar(10) check (class in ('business', 'economy')) not null,
    price decimal(10, 2) not null,
    foreign key (flightid) references flights(flightid),
    foreign key (passengerid) references passengers(passengerid)
);
go

create trigger updateseatsafterticketsale
on tickets
after insert
as
begin
    update f
    set businessseats = businessseats - i.seats_taken
    from flights f
    join (
        select flightid, count(*) as seats_taken
        from inserted
        where class = 'business'
        group by flightid
    ) i on f.flightid = i.flightid;

    update f
    set economyseats = economyseats - i.seats_taken
    from flights f
    join (
        select flightid, count(*) as seats_taken
        from inserted
        where class = 'economy'
        group by flightid
    ) i on f.flightid = i.flightid;
end;
go

create trigger checkseatsbeforeticketsale
on tickets
for insert
as
begin
    if exists (
        select 1
        from inserted i
        join flights f on i.flightid = f.flightid
        where (i.class = 'business' and f.businessseats <= 0)
           or (i.class = 'economy' and f.economyseats <= 0)
    )
    begin
        raiserror('no available seats in the selected class', 16, 1);
        rollback transaction;
    end;
end;
go


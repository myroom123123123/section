go

select count(*) as totalflights
from flights
where month(departuredatetime) = 10 and year(departuredatetime) = 2023;
go

select f.*
from flights f
left join tickets t on f.flightid = t.flightid and t.class = 'business'
where cast(f.departuredatetime as date) = cast(getdate() as date)
group by f.flightid, f.flightnumber, f.departurecity, f.arrivalcity, f.departuredatetime, f.arrivaldatetime, f.duration, f.totalseats, f.businessseats, f.economyseats
having count(t.ticketid) < f.businessseats;
go

select count(*) as totalticketssold, sum(t.price) as totalrevenue
from tickets t
join flights f on t.flightid = f.flightid
where cast(f.departuredatetime as date) = '2023-10-15';
go

